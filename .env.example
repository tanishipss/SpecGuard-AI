# Database
DATABASE_URL=postgresql+psycopg2://specguard:specguard@localhost:5432/specguard
DATABASE_URL_ASYNC=postgresql+asyncpg://specguard:specguard@localhost:5432/specguard

# LLM
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=8

# Chunking
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=75

# Ingested corpus defaults
DEFAULT_RELEASE=Rel-17

# App
ENV=development
CORS_ORIGINS=http://localhost:5173
